# Frontend (Vite) environment.
# Only VITE_* variables are exposed to the Vue bundle. Everything else is
# server-only and lives in ../backend/.env.

VITE_APP_NAME=Kanban

# Reverb (websocket) connection used by resources/js/echo.js.
# These must match the REVERB_* values set in ../backend/.env.
VITE_REVERB_APP_KEY=local-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
